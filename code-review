  다중 키 라운드로빈 + 차단 처리:
    self._keys: list[str]             # API 키 목록
    self._rr: int                     # 라운드로빈 인덱스
    self._blocked_until: list[float]  # 키별 차단 해제 시각 (Unix timestamp)

